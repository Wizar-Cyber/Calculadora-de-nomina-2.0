# ============================================================
# Configuración de Variables de Entorno
# ============================================================
# Copia este archivo a .env.local y ajusta los valores según tu entorno.

# API Base URL
# URL base para todas las llamadas de API

# DESARROLLO (incluye API routes locales de Next.js):
# Usa /api para las rutas locales en src/app/api/*
NEXT_PUBLIC_API_BASE_URL=/api

# PRODUCCIÓN (si usaras backend externo):
# Ejemplo: https://tu-app-nomina.herokuapp.com/api
# NEXT_PUBLIC_API_BASE_URL=https://tu-backend.com/api

# ============================================================
# Notas:
# ============================================================
# - Las variables con prefijo NEXT_PUBLIC_ son visibles en el cliente
# - Backend integrado en Next.js no necesita URL externa
# - Para deployment en Netlify, mantén el valor /api
# - Cambios requieren restart del servidor (npm run dev)


